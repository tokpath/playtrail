# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Required. PostgreSQL connection string.
DATABASE_URL=postgres://playtrail:playtrail@localhost:55432/playtrail?sslmode=disable

API_ADDR=:8081
PUBLIC_BASE_URL=http://localhost:3000
WEB_INTERNAL_URL=http://localhost:3000

# Required for serve/worker. At least 32 bytes, shared with the web frontend.
INTERNAL_SECRET=

MEDIA_DIR=./data/media
OPS_TIMEZONE=Asia/Taipei
SUPPORTED_LOCALES=en,zh
DEFAULT_LOCALE=en
LOCALE_MIN_GAMES=10

SESSION_IDLE_TIMEOUT=30m

# Header carrying the real client IP when behind a reverse proxy/CDN that
# sets it (e.g. CF-Connecting-IP behind Cloudflare). Empty trusts RemoteAddr
# only; the header is honored only for loopback/private remote addresses.
TRUSTED_PROXY_HEADER=

# Hotlinked CrazyGames covers (PRD 22.12). Set false to disable site-wide;
# run `playtrail rebuild-public` afterwards.
EXTERNAL_COVERS_ENABLED=true

CRAWLER_ENABLED=false
CRAWLER_USER_AGENT=PlayTrailBot/1.0 (+http://localhost:3000/en/about)
CRAWLER_DAILY_CAP=3000
CRAWLER_MIN_INTERVAL=2s
CRAWLER_OBSERVED_REGION=TW
HOT_AUTO_PUBLISH=true
