# Copy to deploy/.env and fill in real values. Never commit deploy/.env.
# Local one-command run: SITE_ADDRESS=:8080, HTTP_PORT=8080, HTTPS_PORT=8443.

# --- Public site ---
# Production: your domain, e.g. playtrail.example.com (Caddy obtains and
# renews TLS automatically). Local: :8080 (plain HTTP).
SITE_ADDRESS=:8080
# Host ports published for Caddy's HTTP/HTTPS listeners; the container side
# is fixed (8080/8443). Cloudflare connects to HTTP_PORT/HTTPS_PORT.
HTTP_PORT=80
HTTPS_PORT=443
# Canonical public origin, used for absolute URLs and as the CSRF trusted
# origin. Must match what visitors actually use.
PUBLIC_BASE_URL=

# --- PostgreSQL ---
POSTGRES_USER=playtrail
POSTGRES_PASSWORD=
POSTGRES_DB=playtrail
# api/worker/migrate connect to the compose postgres service by default
# (postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB).
# To point at an external database, set DATABASE_URL explicitly.
DATABASE_URL=

# --- Shared internal secret (Go <-> web, at least 32 bytes) ---
# Generate with: openssl rand -base64 48
INTERNAL_SECRET=

# --- Backend (Go) ---
API_ADDR=:8081
WEB_INTERNAL_URL=http://web:3000
MEDIA_DIR=/data/media
OPS_TIMEZONE=Asia/Taipei
SUPPORTED_LOCALES=en,zh
DEFAULT_LOCALE=en
LOCALE_MIN_GAMES=10
SESSION_IDLE_TIMEOUT=30m

# Header carrying the real client IP when behind Cloudflare
# (CF-Connecting-IP). It is honored only for requests from loopback/private
# addresses and the value must be a single valid IP, so keep it empty only
# when Caddy is not behind a trusted proxy.
TRUSTED_PROXY_HEADER=CF-Connecting-IP

# Hotlinked CrazyGames covers. Set false to disable site-wide, then run
# `docker compose run --rm api rebuild-public`.
EXTERNAL_COVERS_ENABLED=true

# --- Crawler ---
# Deployment-level master switch; the admin panel can toggle it further.
CRAWLER_ENABLED=false
CRAWLER_USER_AGENT=
CRAWLER_DAILY_CAP=3000
CRAWLER_MIN_INTERVAL=2s
CRAWLER_OBSERVED_REGION=TW
HOT_AUTO_PUBLISH=true

# --- Web (Next.js) ---
API_INTERNAL_URL=http://api:8081
